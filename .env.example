# App Settings
DEBUG=True
ENVIRONMENT=development

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME="Noob Busts Scams"

# Security
SECRET_KEY=your-secret-key-here
AUTH_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/db_name

# Redis
REDIS_URL=redis://localhost:6379

# LLM
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3-70b-chat

# Monitoring
COMET_API_KEY=your-comet-api-key
COMET_PROJECT_NAME=noob-busts-scams
COMET_WORKSPACE=your-workspace

# ZenML
ZENML_SERVER_URL=http://localhost:8080
ZENML_USERNAME=default
ZENML_PASSWORD=password

# CORS
ALLOWED_ORIGINS=*